# Data pins for the release driver (tools/reprobuild).  Bumped deliberately,
# reviewed as a diff, exactly like every other pin on this route.
#
# The builder is the upstream `nixos/nix` container, pinned by *index* digest
# so it resolves the same on every architecture.  The release build runs inside
# it, so the host needs docker, coreutils and python3 but no Nix -- and no host
# nix.conf, whose sandbox, substituters and filter-syscalls settings would
# otherwise be unrecorded inputs to a signed artifact.  `--host-nix` is the
# opt-in for whoever has Nix and wants the faster loop; both are expected to
# produce the same bytes, which has been measured on two machines.
NIX_IMAGE=nixos/nix@sha256:7a007c766426c1877758ddc5cb87a965ac131fc78c582ce0083d922d51ae945c
NIX_IMAGE_TAG=2.35.2

# The skopeo the `docker` verb uses for OCI layouts and pushes.
# Ubuntu 22.04's skopeo 1.4.1 lacks --preserve-digests, so the pinned
# container is the normative path (a new enough host skopeo is used if found,
# so this is the floor and not a ceiling).
#
# 1.22.3 is the newest skopeo *image*, which is not the newest skopeo: there are
# v1.23.0, v1.24.0 and v1.24.1 source releases, but no 1.23.x or 1.24.x
# container on quay.io/skopeo/stable (all 77 tags checked), on
# quay.io/containers/skopeo, on ghcr.io or on Docker Hub.  skopeo maintains
# several stable branches at once and backports to them -- v1.22.3 shipped the
# same day as v1.24.1 -- and the image track follows one of those branches.  So
# do not "fix" this to 1.24.x without first checking that an image exists.
#
# By *index* digest, like NIX_IMAGE above and for the same reason: quay's
# version tags float.  `v1.22.3` was re-pushed on 2026-10-02 and no longer
# resolves to the bytes it did on 2026-09-30 -- upstream publishes a separate
# `-immutable` tag precisely because the plain one moves -- so a tag here was
# not a pin at all, however specific it looked.
SKOPEO_IMAGE=quay.io/skopeo/stable@sha256:249b92db7297e5c801e19172dbb3b56fde88094a49740a5ededac8c2958bf2c0
SKOPEO_IMAGE_TAG=v1.22.3

# The runtime image's base digest lives in the Dockerfile itself
# (FROM debian:trixie-slim@sha256:...), bumped deliberately like a pin.
#
# Bitcoin Core: `tools/reprobuild fetch` downloads the release tarballs for
# every arch of the matrix from BITCOIN_URL, verifies SHA256SUMS.asc against
# contrib/keys/bitcoin/ on the host, and extracts bin/bitcoin-cli into the
# cache the Dockerfile COPYs from.  Bumped at release time.
BITCOIN_VERSION=31.1
BITCOIN_URL=https://bitcoincore.org/bin/bitcoin-core-31.1
# Minimum number of good signatures on SHA256SUMS.asc from the vendored keys.
BITCOIN_MIN_SIGS=3
